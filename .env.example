# Keyring — environment variable NAMES only. Never commit real values.
# Copy to .env (gitignored) and fill in locally.

# --- NEAR ---
# Testnet account that owns/deploys the Keyring contract, e.g. keyring.testnet
NEAR_ACCOUNT_ID=
# Private key for NEAR_ACCOUNT_ID. Testnet only. Never a mainnet key.
NEAR_PRIVATE_KEY=
NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
# Deployed Keyring contract account
KEYRING_CONTRACT_ID=

# --- NEAR Chain Signatures (MPC) ---
# Testnet MPC signer contract account
MPC_SIGNER_CONTRACT_ID=v1.signer-prod.testnet

# --- Agent credential (scoped to KEYRING_CONTRACT_ID only) ---
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# --- Base Sepolia ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532

# --- Bitcoin testnet4 ---
BITCOIN_RPC_URL=
BITCOIN_NETWORK=testnet4
