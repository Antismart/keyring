{
  "name": "@keyring/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Keyring contract",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "near-api-js": "7.4.0",
    "viem": "2.37.6"
  }
}
