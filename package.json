{
  "name": "keyring",
  "private": true,
  "version": "0.1.0",
  "description": "Policy-enforced wallet infrastructure for AI agents",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "contract:check": "cargo clippy --target wasm32-unknown-unknown -- -D warnings",
    "contract:test": "cargo test",
    "contract:build": "cd contracts/keyring && cargo near build non-reproducible-wasm",
    "contract:abi": "cd contracts/keyring && cargo near abi",
    "verify:signature": "node scripts/verify-signature.mjs"
  },
  "devDependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "typescript": "5.9.3",
    "viem": "2.37.6"
  }
}
